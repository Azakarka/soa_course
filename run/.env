# NOTE: this variables will not work locally because they depend on docker dns

# Postgres env
POSTGRES_USER=user_service
POSTGRES_PASSWORD=password123
POSTGRES_DB=user_db

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=password123


# Proxy env
USER_SERVICE_HOST=user
USER_SERVICE_PORT=8082



# User env
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user_service:password123@db:5432/user_db?schema=public

# debug
RUST_LOG=debug

# Cert
# PRIVATE_KEY_PATH="/app/cert/private.key"
# PUBLIC_KEY_PATH="/app/cert/private.key.pub"
